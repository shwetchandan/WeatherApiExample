<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/weather_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            style="@style/WeatherTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/weather"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubtitle"
            style="@style/WeatherSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/live_conditions_powered_by_openweathermap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFetch"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/refresh_weather"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/weather_accent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnFetch"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weatherCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/weather_card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnFetch"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="28dp"
                android:paddingBottom="20dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCityName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:gravity="center"
                    android:text="@string/ahmedabad"
                    android:textSize="30sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/default_temperature"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCityName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/weather_condition"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTemp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFeelsLike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/feels_like_default"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHumidity"
                    style="@style/WeatherValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:text="@string/default_percentage"
                    app:layout_constraintEnd_toStartOf="@id/tvWind"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvFeelsLike" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWind"
                    style="@style/WeatherValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/default_wind"
                    app:layout_constraintEnd_toStartOf="@id/tvPressure"
                    app:layout_constraintStart_toEndOf="@id/tvHumidity"
                    app:layout_constraintTop_toTopOf="@id/tvHumidity" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPressure"
                    style="@style/WeatherValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/default_pressure"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvWind"
                    app:layout_constraintTop_toTopOf="@id/tvHumidity" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHumidityLabel"
                    style="@style/WeatherLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/humidity"
                    app:layout_constraintEnd_toEndOf="@id/tvHumidity"
                    app:layout_constraintStart_toStartOf="@id/tvHumidity"
                    app:layout_constraintTop_toBottomOf="@id/tvHumidity" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWindLabel"
                    style="@style/WeatherLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/wind"
                    app:layout_constraintEnd_toEndOf="@id/tvWind"
                    app:layout_constraintStart_toStartOf="@id/tvWind"
                    app:layout_constraintTop_toBottomOf="@id/tvWind" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPressureLabel"
                    style="@style/WeatherLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/pressure"
                    app:layout_constraintEnd_toEndOf="@id/tvPressure"
                    app:layout_constraintStart_toStartOf="@id/tvPressure"
                    app:layout_constraintTop_toBottomOf="@id/tvPressure" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvVisibility"
                    style="@style/WeatherValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/default_visibility"
                    app:layout_constraintEnd_toStartOf="@id/tvSunrise"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHumidityLabel" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSunrise"
                    style="@style/WeatherValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/default_time"
                    app:layout_constraintEnd_toStartOf="@id/tvSunset"
                    app:layout_constraintStart_toEndOf="@id/tvVisibility"
                    app:layout_constraintTop_toTopOf="@id/tvVisibility" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSunset"
                    style="@style/WeatherValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/default_time"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvSunrise"
                    app:layout_constraintTop_toTopOf="@id/tvVisibility" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvVisibilityLabel"
                    style="@style/WeatherLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/visibility"
                    app:layout_constraintEnd_toEndOf="@id/tvVisibility"
                    app:layout_constraintStart_toStartOf="@id/tvVisibility"
                    app:layout_constraintTop_toBottomOf="@id/tvVisibility" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSunriseLabel"
                    style="@style/WeatherLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/sunrise"
                    app:layout_constraintEnd_toEndOf="@id/tvSunrise"
                    app:layout_constraintStart_toStartOf="@id/tvSunrise"
                    app:layout_constraintTop_toBottomOf="@id/tvSunrise" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSunsetLabel"
                    style="@style/WeatherLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/sunset"
                    app:layout_constraintEnd_toEndOf="@id/tvSunset"
                    app:layout_constraintStart_toStartOf="@id/tvSunset"
                    app:layout_constraintTop_toBottomOf="@id/tvSunset" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weatherCard"
            tools:text="@string/default_error"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>